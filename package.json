{
  "name": "openlfcp-bridge",
  "version": "0.5.0",
  "private": true,
  "description": "lfcp-bridge: LFCP shared sections <-> Apple apps, as one more device of the person (workspace root).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "c-year": "LFCP_C_YEAR=1 LFCP_REQUIRE_LIVE=1 vitest run packages/host/test/c-year.live.test.ts",
    "lint": "biome check . && node scripts/check-boundaries.mjs && node scripts/check-boundaries.mjs --self-test && node scripts/sdk-ts-pack.mjs --self-test",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@openlfcp/core": "file:vendor/sdk-ts/openlfcp-core-0.6.0.tgz",
      "@openlfcp/crypto": "file:vendor/sdk-ts/openlfcp-crypto-0.6.0.tgz",
      "@openlfcp/storage": "file:vendor/sdk-ts/openlfcp-storage-0.6.0.tgz",
      "@openlfcp/wire": "file:vendor/sdk-ts/openlfcp-wire-0.6.0.tgz",
      "@openlfcp/storage-idb": "file:vendor/sdk-ts/openlfcp-storage-idb-0.6.0.tgz",
      "@openlfcp/shared-objects": "file:vendor/sdk-ts/openlfcp-shared-objects-0.6.0.tgz",
      "@openlfcp/client": "file:vendor/sdk-ts/openlfcp-client-0.6.0.tgz",
      "@openlfcp/storage-node": "file:vendor/sdk-ts/openlfcp-storage-node-0.6.0.tgz"
    }
  }
}
